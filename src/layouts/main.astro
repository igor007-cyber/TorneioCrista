---
// Layout base reutilizável — centraliza todo o SEO (title, description, canonical,
// Open Graph, Twitter Card, robots) para que cada página só precise passar props.
import '../styles/global.css';
import logo from '../assets/logo.png';

interface Props {
	/** Título da aba/resultado de busca. */
	title?: string;
	/** Descrição usada no snippet do Google e nos compartilhamentos. */
	description?: string;
	/** Imagem de compartilhamento (Open Graph / Twitter). URL absoluta ou caminho. */
	image?: string;
	/** Quando true, pede aos buscadores para NÃO indexar (páginas administrativas). */
	noindex?: boolean;
	/** Tipo Open Graph (website, article, ...). */
	type?: string;
	/** Sobrescreve a URL canônica (usado em páginas de redirecionamento). */
	canonical?: string;
}

const {
	title = 'Copa Cristã Fortaleza 2026',
	description = 'Copa Cristã Fortaleza 2026: campeonato esportivo que reúne 17 igrejas evangélicas e mais de 500 atletas em Fortaleza/CE. Acompanhe os jogos, tabelas e a classificação de futsal, vôlei e basquete, masculino e feminino.',
	image = 'https://i.imgur.com/CxeBixA.jpeg',
	noindex = false,
	type = 'website',
	canonical,
} = Astro.props;

// Astro.site vem do campo `site` do astro.config; se ausente (dev), cai no domínio fixo.
const siteBase = Astro.site ?? new URL('https://copacristafortaleza.com.br');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteBase).href;
const ogImage = image.startsWith('http') ? image : new URL(image, siteBase).href;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="theme-color" content="#070c12" />

		<!-- Open Graph (Facebook, WhatsApp, Instagram, LinkedIn) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Copa Cristã Fortaleza" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Copa Cristã Fortaleza" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href={logo.src} />
		<link rel="apple-touch-icon" href={logo.src} />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Rajdhani:wght@500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>

		<slot name="head" />
	</head>
	<body class="text-slate-900">
		<slot />
	</body>
</html>
