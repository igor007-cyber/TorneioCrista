---
// A home passou a ser servida na raiz "/". Esta rota antiga (/home) apenas
// redireciona para lá, preservando links já compartilhados. É noindex e tem a
// canônica apontando para "/" para não competir com a página principal no Google.
import MainLayout from '../layouts/main.astro';
---

<MainLayout
	title="Copa Cristã Fortaleza 2026"
	noindex={true}
	canonical="https://copacristafortaleza.com.br/"
>
	<meta http-equiv="refresh" content="0; url=/" slot="head" />

	<main class="min-h-[50vh] flex items-center justify-center px-6 text-center">
		<div>
			<p class="text-slate-600 mb-3">Redirecionando para a página principal…</p>
			<a href="/" class="text-blue-700 font-semibold hover:text-blue-900">
				Clique aqui se não for redirecionado automaticamente.
			</a>
		</div>
	</main>
</MainLayout>

<script>
	window.location.replace('/');
</script>
