---
import MainLayout from '../layouts/main.astro';
import logo from '../assets/logo.png';
import './css/home.css';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Instagram', href: 'https://www.instagram.com/copacristafortaleza/' },
	{ label: 'Jogos', href: '/vizualizarTorneio' },
];

const socialImages = [
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/Pib-121.jpg?bwg=1752182548',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/Pib-203.jpg?bwg=1752182549',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/Pib-439.jpg?bwg=1752182552',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/Pib-706.jpg?bwg=1752183282',
];
---

<MainLayout title="Copa Cristã Fortaleza">
	<main class="plx-page">
		<header class="plx-header">
			<div class="plx-logo">
				<img src={logo.src} alt="Logo Copa Cristã Fortaleza" class="plx-logo-image" />
				<div>
					<p>Copa Cristã</p>
					<strong>Fortaleza</strong>
				</div>
			</div>

			<nav class="plx-nav" aria-label="Principal">
				{navItems.map((item, index) => (
					<a
						href={item.href}
						target={item.href.startsWith('http') ? '_blank' : undefined}
						rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
						class={index === 0 ? 'active' : ''}
					>
						{item.label}
					</a>
				))}
			</nav>

			<a href="/login" class="plx-menu-button">Entrar</a>
		</header>

		<section class="plx-hero">
			<div class="plx-side-social">
				<a href="https://www.instagram.com/copacristafortaleza/" target="_blank" rel="noreferrer">IG</a>
				<a href="https://pibfortaleza.org.br/" target="_blank" rel="noreferrer">PIB</a>
				<a href="/login">GO</a>
			</div>

			<div class="plx-hero-media">
				<img
					src="https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/088-I-Copa-Crista_05jul25_manha_8670.png?bwg=1752182755"
					alt="Atletas da Copa Cristã em ação"
				/>
				<div class="plx-hero-overlay"></div>
			</div>

			<div class="plx-hero-content">
				<div class="plx-hero-box">
					<h1>Copa Cristã 2026</h1>
					<p class="plx-hero-text">
						A segunda edição da Copa Cristã de Fortaleza/CE conta com a participação de 17 igrejas e mais
						de 500 atletas. A competição acontece nos dias 17, 18, 24 e 25/07, no Colégio 7 de Setembro
						Aldeota.
					</p>
					<div class="plx-hero-actions">
						<a href="/login" class="plx-btn-primary">Entrar no sistema</a>
						<a href="/vizualizarTorneio" class="plx-btn-secondary">Ver os jogos</a>
					</div>
				</div>
			</div>

			
		</section>

		<section class="plx-story">
			<div class="plx-story-copy">
				<p class="plx-section-kicker">Sobre a Copa</p>
				<h2>Uma experiência criada para unir esporte, competição e comunhão</h2>
				<p>
					A Copa Cristã surgiu com o objetivo de proporcionar interação e competição esportiva para
					igrejas evangélicas de Fortaleza. Temos igrejas de diversas denominações e estilos e o intuito
					é justamente esse: promover esse tempo de comunhão entre essas diferentes comunidades cristãs.
				</p>
				<p>
					Nosso foco é ter um espaço de competição saudável, onde todos disputam com lealdade para ganhar,
					mas se lembram de que nosso testemunho vem em primeiro lugar. Que essa Copa seja abençoada e
					através dela surjam amizades e boas lembranças, pois esse é o nosso principal intuito.
				</p>
				<p><strong>André Cavallari</strong> (organizador geral do evento).</p>
				<p>Confira aqui o nosso regulamento da Copa Cristã 2026. Segue link para baixar o regulamento:</p>
				<a
					href="https://1drv.ms/b/c/95af7a3de5c51cc5/IQAP9h3EoYqcSYWdSjgMIjUZAWhXe2igTuaONScj_qsGGBw?e=Ev0uMY"
					target="_blank"
					rel="noreferrer"
					class="plx-inline-link"
				>
					Regulamento Copa Cristã 2026
				</a>
			</div>

			<div class="plx-story-media">
				<img
					src="https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/076-I-Copa-Crista_05jul25_manha_8635.png?bwg=1752182755"
					alt="Partida da Copa Cristã"
				/>
				<div class="plx-play-badge">COPA</div>
			</div>
		</section>

		<section class="plx-social-wall">
			<div class="plx-social-title">
				<h2>Compartilhe com #CopaCristãFortaleza</h2>
				<p>Siga e acompanhe novidades pelo Instagram oficial.</p>
			</div>
			<div class="plx-social-grid">
				{socialImages.map((image) => (
					<img src={image} alt="Registro da Copa Cristã" loading="lazy" />
				))}
			</div>
		</section>

		<footer class="plx-footer">
			<div class="plx-footer-brand">
				<div class="plx-logo">
					<img src={logo.src} alt="Logo Copa Cristã Fortaleza" class="plx-logo-image" />
					<div>
						<p>Copa Cristã</p>
						<strong>Fortaleza</strong>
					</div>
				</div>
				<p>
					Página principal da Copa Cristã organizada pela Primeira Igreja Batista de Fortaleza, com acesso
					ao sistema de gestão dos jogos e acompanhamento do campeonato.
				</p>
			</div>

			<div>
				<h3>Organização</h3>
				<p>PIB Fortaleza</p>
				<p>Rua Silva Paulet, 1111</p>
				<p>Aldeota, Fortaleza/CE</p>
			</div>

			<div>
				<h3>Contatos</h3>
				<p>andrecavallari.m@gmail.com</p>
				<p>@copacristafortaleza</p>
			</div>

			<div>
				<h3>Acessos</h3>
				<a href="/login">Login da organização</a>
				<a href="/vizualizarTorneio">Jogos cadastrados</a>
			</div>
		</footer>
	</main>
</MainLayout>
