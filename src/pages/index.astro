---
import MainLayout from '../layouts/main.astro';
import logo from '../assets/logo.png';
import logoConecta from '../assets/image/Logo Conecta branca.png';
import logoIcar from '../assets/image/LOGO ICAR BRANCA.png';
import logoMariaP from '../assets/image/LOGO MARIA P.png';
import logoPng from '../assets/image/LOGO PNG.png';
import logoRioVerde from '../assets/image/Logo Rio Verde.png';
import logoRogerTadeu from '../assets/image/Logo Roger e Tadeu.png';
import logoSupri from '../assets/image/Logo Supri branca.png';
import logoSta from '../assets/image/STA BRANCA.png';
import './css/home.css';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Instagram', href: 'https://www.instagram.com/copacristafortaleza/' },
	{ label: 'Jogos', href: '/vizualizarTorneio' },
	{ label: 'Participação', href: '#churches-section' },
];

const sponsors = [
	{ name: 'Conecta', image: logoConecta },
	{ name: 'ICAR', image: logoIcar },
	{ name: 'Maria P', image: logoMariaP },
	{ name: 'Patrocinador', image: logoPng },
	{ name: 'Rio Verde', image: logoRioVerde },
	{ name: 'Roger e Tadeu', image: logoRogerTadeu },
	{ name: 'Supri', image: logoSupri },
	{ name: 'STA', image: logoSta },
];

// Slides do banner. Trocam sozinhos em crossfade; a primeira entra com
// prioridade alta porque é o LCP da página.
const heroImages = [
	'https://i.imgur.com/CxeBixA.jpeg',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC02527_resized.jpg?bwg=1784580623',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC02731_resized.jpg?bwg=1784580622',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC03593_resized.jpg?bwg=1784580620',
];

const socialImages = [
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC02494_resized.jpg?bwg=1784580623',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC03296_resized.jpg?bwg=1784580620',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC03513_resized.jpg?bwg=1784580620',
	'https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC04850_resized.jpg?bwg=1784580617',
];

// Dados estruturados (JSON-LD) — ajudam o Google a exibir o evento com data,
// local e organizador nos resultados de busca.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SportsEvent',
	name: 'Copa Cristã Fortaleza 2026',
	description:
		'2ª edição da Copa Cristã de Fortaleza/CE, reunindo 17 igrejas evangélicas e mais de 500 atletas nas modalidades futsal, vôlei e basquete (masculino e feminino).',
	sport: ['Futsal', 'Vôlei', 'Basquete'],
	startDate: '2026-07-17',
	endDate: '2026-07-25',
	eventStatus: 'https://schema.org/EventScheduled',
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	image: 'https://i.imgur.com/CxeBixA.jpeg',
	url: 'https://copacristafortaleza.com.br/',
	location: {
		'@type': 'Place',
		name: 'Colégio 7 de Setembro — Aldeota',
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Fortaleza',
			addressRegion: 'CE',
			addressCountry: 'BR',
		},
	},
	organizer: {
		'@type': 'Organization',
		name: 'Primeira Igreja Batista de Fortaleza (PIB Fortaleza)',
		url: 'https://pibfortaleza.org.br/',
	},
};
---

<MainLayout
	title="Copa Cristã Fortaleza 2026 — Campeonato Esportivo Cristão"
	description="Copa Cristã Fortaleza 2026: campeonato que reúne 17 igrejas evangélicas e mais de 500 atletas em Fortaleza/CE. Acompanhe jogos, tabelas e classificação de futsal, vôlei e basquete, masculino e feminino."
	type="website"
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

	<main class="plx-page">
		<header class="plx-header">
			<div class="plx-logo">
				<img src={logo.src} alt="Logo Copa Cristã Fortaleza" class="plx-logo-image" />
				<div>
					<p>Copa Cristã</p>
					<strong>Fortaleza</strong>
				</div>
			</div>

			<nav class="plx-nav" aria-label="Principal">
				{navItems.map((item, index) => (
					<a
						href={item.href}
						target={item.href.startsWith('http') ? '_blank' : undefined}
						rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
						class={index === 0 ? 'active' : ''}
					>
						{item.label}
					</a>
				))}
			</nav>

			<a href="/login" class="plx-menu-button">Entrar</a>
		</header>

		<section class="plx-hero">
			<div class="plx-side-social">
				<a href="https://www.instagram.com/copacristafortaleza/" target="_blank" rel="noreferrer">IG</a>
				<a href="https://pibfortaleza.org.br/" target="_blank" rel="noreferrer">PIB</a>
				<a href="/login">GO</a>
			</div>

			<div class="plx-hero-media" data-hero-carousel>
				{heroImages.map((image, index) => (
					<img
						src={image}
						alt="Atletas da Copa Cristã em ação"
						class={index === 0 ? 'is-active' : undefined}
						fetchpriority={index === 0 ? 'high' : undefined}
					/>
				))}
				<div class="plx-hero-overlay"></div>
			</div>

			<div class="plx-hero-content">
				<div class="plx-hero-box">
					<h1>Copa Cristã 2026</h1>
					<p class="plx-hero-text">
						A segunda edição da Copa Cristã de Fortaleza/CE conta com a participação de 17 igrejas e mais
						de 500 atletas. A competição acontece nos dias 17, 18, 24 e 25/07, no Colégio 7 de Setembro
						Aldeota.
					</p>
					<div class="plx-hero-actions">
						<a href="/vizualizarTorneio" class="plx-btn-primary">Ver os jogos</a>
						<a href="#churches-section" class="plx-btn-secondary">Igreja que estao participando</a>
					</div>
				</div>
			</div>


		</section>

		<section class="plx-story">
			<div class="plx-story-copy">
				<p class="plx-section-kicker">Sobre a Copa</p>
				<h2>Uma experiência criada para unir esporte, competição e comunhão</h2>
				<p>
					A Copa Cristã surgiu com o objetivo de proporcionar interação e competição esportiva para
					igrejas evangélicas de Fortaleza. Temos igrejas de diversas denominações e estilos e o intuito
					é justamente esse: promover esse tempo de comunhão entre essas diferentes comunidades cristãs.
				</p>
				<p>
					Nosso foco é ter um espaço de competição saudável, onde todos disputam com lealdade para ganhar,
					mas se lembram de que nosso testemunho vem em primeiro lugar. Que essa Copa seja abençoada e
					através dela surjam amizades e boas lembranças, pois esse é o nosso principal intuito.
				</p>
				<p><strong>André Cavallari</strong> (organizador geral do evento).</p>
				<p class="mt-3">Confira aqui o nosso regulamento da Copa Cristã 2026: </p>
				<a
					href="https://1drv.ms/b/c/95af7a3de5c51cc5/IQAP9h3EoYqcSYWdSjgMIjUZAWhXe2igTuaONScj_qsGGBw?e=Ev0uMY"
					target="_blank"
					rel="noreferrer"
					class="plx-inline-link"
				>
					Regulamento Copa Cristã 2026
				</a>
			</div>

			<div class="plx-story-media">
				<img
					src="https://pibfortaleza.org.br/wp-content/uploads/photo-gallery/DSC02482_resized.jpg?bwg=1784580623"
					alt="Time reunido em comemoração durante a Copa Cristã"
				/>

			</div>
		</section>

		<section class="plx-social-wall">
			<div class="plx-sponsors">
				<p class="plx-sponsors-label">Patrocinadores</p>
				<div class="plx-sponsors-marquee" data-sponsors-marquee>
					<div class="plx-sponsors-track" data-sponsors-track>
						{[0, 1].map((copy) => (
							<div class="plx-sponsors-group" aria-hidden={copy === 1 ? 'true' : undefined}>
								{sponsors.map((sponsor) => (
									<img src={sponsor.image.src} alt={`Logo ${sponsor.name}`} loading="lazy" />
								))}
							</div>
						))}
					</div>
				</div>
			</div>

			<div class="plx-social-title">
				<h2>Compartilhe com #CopaCristãFortaleza</h2>
				<p>Siga e acompanhe novidades pelo Instagram oficial.</p>
			</div>
			<div class="plx-social-grid">
				{socialImages.map((image) => (
					<img src={image} alt="Registro da Copa Cristã" loading="lazy" />
				))}
			</div>
		</section>

		<section class="plx-churches" id="churches-section">
			<div class="plx-churches-head">
				<p class="plx-section-kicker">Quem está na disputa</p>
				<h2>Igrejas participantes 2026</h2>

			</div>
			<div class="plx-churches-grid" id="churches-grid"></div>
		</section>

		<footer class="plx-footer">
			<div class="plx-footer-brand">
				<div class="plx-logo">
					<img src={logo.src} alt="Logo Copa Cristã Fortaleza" class="plx-logo-image" />
					<div>
						<p>Copa Cristã</p>
						<strong>Fortaleza</strong>
					</div>
				</div>
				<p>
					Página principal da Copa Cristã organizada pela Primeira Igreja Batista de Fortaleza, com acesso
					ao sistema de gestão dos jogos e acompanhamento do campeonato.
				</p>
			</div>

			<div>
				<h3>Organização</h3>
				<p>PIB Fortaleza</p>
				<p>Rua Silva Paulet, 1111</p>
				<p>Aldeota, Fortaleza/CE</p>
			</div>

			<div>
				<h3>Contatos</h3>
				<p>andrecavallari.m@gmail.com</p>
				<p>@copacristafortaleza</p>
			</div>

			<div>
				<h3>Acessos</h3>
				<a href="/login">Login da organização</a>
				<a href="/vizualizarTorneio">Jogos cadastrados</a>
			</div>
		</footer>
	</main>

	<script>
		// Carrossel do banner: troca automática em crossfade. O CSS cuida da
		// transição; aqui só movemos a classe `is-active` de um slide para o outro.
		const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
		const slides = carousel ? [...carousel.querySelectorAll('img')] : [];

		if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const HOLD_MS = 5500;
			let current = slides.findIndex((slide) => slide.classList.contains('is-active'));
			if (current < 0) current = 0;
			let timer = 0;

			const show = (next: number) => {
				slides[current].classList.remove('is-active');
				current = next;
				slides[current].classList.add('is-active');
			};

			const advance = () => show((current + 1) % slides.length);

			const start = () => {
				clearInterval(timer);
				timer = setInterval(advance, HOLD_MS);
			};

			// Com a aba em segundo plano o navegador estrangula o timer e as
			// transições não rodam; parar e recomeçar evita voltar com vários
			// slides "acumulados" trocando de uma vez.
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) clearInterval(timer);
				else start();
			});

			start();
		}
	</script>

	<script>
		import gsap from 'gsap';

		const marquee = document.querySelector<HTMLElement>('[data-sponsors-marquee]');
		const track = document.querySelector<HTMLElement>('[data-sponsors-track]');

		if (marquee && track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const PIXELS_PER_SECOND = 30;
			let tween: gsap.core.Tween | null = null;

			// O track contém duas cópias idênticas da lista, então deslocar 50% da sua
			// largura recoloca a segunda cópia exatamente onde a primeira começou.
			const build = () => {
				tween?.kill();
				gsap.set(track, { xPercent: 0 });
				const loopWidth = track.scrollWidth / 2;
				if (loopWidth === 0) return;
				tween = gsap.to(track, {
					xPercent: -50,
					ease: 'none',
					repeat: -1,
					duration: loopWidth / PIXELS_PER_SECOND,
				});
			};

			build();

			marquee.addEventListener('pointerenter', () => tween?.pause());
			marquee.addEventListener('pointerleave', () => tween?.play());

			// As logos usam loading="lazy": a largura só é definitiva depois que cada
			// uma decodifica, e o resize muda a altura base dos itens.
			let resizeTimer = 0;
			addEventListener('resize', () => {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(build, 150);
			});
			for (const img of track.querySelectorAll('img')) {
				if (!img.complete) img.addEventListener('load', build, { once: true });
			}
		}
	</script>

	<script>
		import { listTournaments, loadTournaments } from '../lib/storage';
		import { SPORT_LABEL, GENDER_LABEL } from '../lib/tournament';
		import type { Gender, Sport } from '../lib/types';

		// Ordem fixa das seis categorias exibidas. Os nomes das igrejas NÃO ficam
		// no código: são lidos dos torneios cadastrados (config.teams) e agrupados
		// por esporte + gênero, então a lista se mantém sozinha conforme a
		// organização cadastra/edita os times no painel.
		const CATEGORIES: { sport: Sport; gender: Gender; icon: string }[] = [
			{ sport: 'futebol',  gender: 'masculino', icon: '⚽' },
			{ sport: 'futebol',  gender: 'feminino',  icon: '⚽' },
			{ sport: 'volei',    gender: 'masculino', icon: '🏐' },
			{ sport: 'volei',    gender: 'feminino',  icon: '🏐' },
			{ sport: 'basquete', gender: 'masculino', icon: '🏀' },
			{ sport: 'basquete', gender: 'feminino',  icon: '🏀' },
		];

		const gridEl = document.getElementById('churches-grid');

		function escapeHtml(value: string): string {
			return value
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		/** "W.O.", "WO", "BYE" e afins não são igrejas: são vagas de preenchimento
		 *  usadas na chave quando o número de times é ímpar. Precisam continuar no
		 *  torneio (senão a chave quebra), mas não podem aparecer nesta lista. */
		function isPlaceholder(name: string): boolean {
			const key = name
				.toLocaleLowerCase('pt-BR')
				.replace(/[.\s-]/g, '');
			return key === 'wo' || key === 'bye';
		}

		/** Igrejas de uma categoria: junta os times de todos os torneios daquele
		 *  esporte+gênero, remove repetidos (sem diferenciar maiúsc./minúsc.) e ordena. */
		function churchesFor(sport: Sport, gender: Gender): string[] {
			const seen = new Map<string, string>();
			for (const t of listTournaments()) {
				if (t.config.sport !== sport || t.config.gender !== gender) continue;
				for (const raw of t.config.teams ?? []) {
					const name = raw.trim();
					if (!name || isPlaceholder(name)) continue;
					const key = name.toLocaleLowerCase('pt-BR');
					if (!seen.has(key)) seen.set(key, name);
				}
			}
			return [...seen.values()].sort((a, b) => a.localeCompare(b, 'pt-BR'));
		}

		function render(): void {
			if (!gridEl) return;

			gridEl.innerHTML = CATEGORIES.map(({ sport, gender, icon }) => {
				const churches = churchesFor(sport, gender);
				const count = churches.length;
				const countLabel = count === 0
					? 'Em breve'
					: `${count} ${count === 1 ? 'igreja' : 'igrejas'}`;

				const body = count === 0
					? '<p class="plx-church-empty">Divulgação em breve.</p>'
					: `<ul class="plx-church-list">${churches
							.map((name) => `<li>${escapeHtml(name)}</li>`)
							.join('')}</ul>`;

				return `
					<article class="plx-church-card is-${gender}">
						<div class="plx-church-top">
							<span class="plx-church-icon">${icon}</span>
							<div class="plx-church-heading">
								<h3>${SPORT_LABEL[sport]} <em>${GENDER_LABEL[gender]}</em></h3>
								<span class="plx-church-count">${countLabel}</span>
							</div>
						</div>
						${body}
					</article>`;
			}).join('');
		}

		// Pinta já com o cache local (rápido) e repinta com o que vier do banco.
		render();
		void loadTournaments().then(render);
	</script>
</MainLayout>
