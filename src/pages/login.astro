---
import MainLayout from '../layouts/main.astro';
import './css/login.css';
---

<MainLayout title="Copa Cristã — Login" noindex={true}>
	<main class="cc-login-page">
		<section class="cc-login-card">
			<div class="cc-login-copy">
				<h1>2º Copa Cristã Fortaleza</h1>

				<div class="cc-login-links">
					<a href="/">Voltar para a página principal</a>
				</div>
			</div>

			<form id="login-form" class="cc-login-form">
				<label>
					<span>E-mail</span>
					<input id="email" type="email" class="cc-login-input" placeholder="voce@copacrista.com" required />
				</label>

				<label>
					<span>Senha</span>
					<input id="password" type="password" class="cc-login-input" placeholder="Senha de acesso" required />
				</label>

				<label>
					<span>Função</span>
					<input type="text" class="cc-login-input" value="Organização da Copa Cristã" disabled />
				</label>

				<p id="login-error" class="cc-login-error" hidden></p>

				<button type="submit" class="cc-login-submit">Entrar no painel</button>
			</form>
		</section>
	</main>
</MainLayout>

<script>
	import { getSession, saveSession } from '../lib/auth';
	import { supabase } from '../lib/supabase';

	const form = document.getElementById('login-form') as HTMLFormElement | null;
	const errorEl = document.getElementById('login-error') as HTMLParagraphElement | null;
	const emailInput = document.getElementById('email') as HTMLInputElement | null;
	const passwordInput = document.getElementById('password') as HTMLInputElement | null;
	const submitBtn = document.querySelector('.cc-login-submit') as HTMLButtonElement | null;
	const params = new URLSearchParams(window.location.search);
	const next = params.get('next') || '/painel';

	if (getSession()) {
		window.location.href = next;
	}

	function showError(message: string) {
		if (!errorEl) return;
		errorEl.hidden = false;
		errorEl.textContent = message;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!emailInput || !passwordInput || !errorEl) return;

		const email = emailInput.value.trim();
		const password = passwordInput.value;

		if (!email || !password) {
			showError('Preencha e-mail e senha para continuar.');
			return;
		}

		errorEl.hidden = true;
		if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Entrando...'; }

		const { data, error } = await supabase.rpc('verify_login', {
			p_email: email,
			p_password: password,
		});

		if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Entrar no painel'; }

		if (error) {
			showError('Erro ao conectar com o servidor. Tente novamente.');
			return;
		}

		const user = Array.isArray(data) ? data[0] : null;
		if (!user) {
			showError('E-mail ou senha incorretos.');
			passwordInput.value = '';
			return;
		}

		saveSession({
			name: user.email,
			email: user.email,
			loggedAt: Date.now(),
		});

		window.location.href = next;
	});
</script>
