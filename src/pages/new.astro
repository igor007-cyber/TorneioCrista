---
// Página de configuração de um novo torneio.
// Ao submeter, gera o torneio e redireciona para a listagem em /painel.
import MainLayout from '../layouts/main.astro';
---

<MainLayout title="CopaCrista — Novo Torneio">
	<main class="max-w-4xl mx-auto px-5 py-10 md:py-14">
		<!-- Voltar -->
		<a href="/painel" class="inline-flex items-center gap-1 text-sm text-blue-700 hover:text-blue-900 font-medium mb-4">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
			Meus torneios
		</a>

		<!-- Cabeçalho -->
		<header class="text-center mb-10 cc-animate-in">
			<div class="inline-flex items-center gap-3 mb-4">
				<div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 grid place-items-center shadow-lg shadow-blue-500/30">
					<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
						<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
						<path d="M4 22h16"/>
						<path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
						<path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
						<path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
					</svg>
				</div>
				<h1 class="text-3xl md:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-blue-700 to-indigo-700 bg-clip-text text-transparent">
					Novo Torneio
				</h1>
			</div>
			<p class="text-slate-600 text-lg">Configure uma nova competição</p>
			<p class="text-slate-500 text-sm mt-1">Defina esporte, formato e times — depois você organiza quem joga onde.</p>
		</header>

		<!-- Formulário -->
		<form id="config-form" class="cc-card rounded-3xl p-6 md:p-10 space-y-8 cc-animate-in" novalidate>
			<!-- Esporte -->
			<section>
				<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Esporte</h2>
				<div class="cc-pill" role="radiogroup" aria-label="Esporte">
					<input type="radio" id="sport-futebol" name="sport" value="futebol" checked />
					<label for="sport-futebol">⚽ Futsal</label>
					<input type="radio" id="sport-basquete" name="sport" value="basquete" />
					<label for="sport-basquete">🏀 Basquete</label>
					<input type="radio" id="sport-volei" name="sport" value="volei" />
					<label for="sport-volei">🏐 Vôlei</label>
				</div>
			</section>

			<!-- Gênero -->
			<section>
				<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Categoria</h2>
				<div class="cc-pill" role="radiogroup" aria-label="Categoria">
					<input type="radio" id="gender-m" name="gender" value="masculino" checked />
					<label for="gender-m">Masculino</label>
					<input type="radio" id="gender-f" name="gender" value="feminino" />
					<label for="gender-f">Feminino</label>
				</div>
			</section>

			<!-- Formato -->
			<section>
				<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Formato da competição</h2>
				<div class="cc-pill" role="radiogroup" aria-label="Formato">
					<input type="radio" id="fmt-grupos" name="format" value="grupos" checked />
					<label for="fmt-grupos">Fase de Grupos</label>
					<input type="radio" id="fmt-corrido" name="format" value="corrido" />
					<label for="fmt-corrido">Campeonato Corrido</label>
					<input type="radio" id="fmt-ko" name="format" value="mata-mata" />
					<label for="fmt-ko">Mata-Mata</label>
				</div>
				<p id="format-hint" class="text-xs text-slate-500 mt-2"></p>
			</section>

			<!-- Times -->
			<section>
				<div class="flex items-center justify-between mb-3">
					<h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Times participantes</h2>
					<div class="flex items-center gap-2">
						<label for="team-count" class="text-xs text-slate-600 font-medium">Quantidade:</label>
						<div class="flex items-center rounded-xl bg-blue-50 border border-blue-200">
							<button type="button" id="btn-minus" class="px-3 py-1.5 text-blue-700 font-bold hover:bg-blue-100 rounded-l-xl">−</button>
							<input id="team-count" type="number" min="3" max="32" value="4"
								class="w-14 text-center bg-transparent border-0 font-semibold text-blue-800 focus:outline-none" />
							<button type="button" id="btn-plus" class="px-3 py-1.5 text-blue-700 font-bold hover:bg-blue-100 rounded-r-xl">+</button>
						</div>
					</div>
				</div>
				<div id="teams-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
				<p id="teams-error" class="text-sm text-rose-600 mt-2 hidden"></p>
			</section>

			<!-- Ações -->
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3 pt-2">
				<button type="button" id="btn-fill" class="cc-btn cc-btn-ghost">
					Preencher com exemplos
				</button>
				<button type="submit" class="cc-btn cc-btn-primary sm:ml-auto text-base">
					Organizar times
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M13 5l7 7-7 7"/>
					</svg>
				</button>
			</div>
		</form>

		<!-- Etapa 2 — organização manual dos times (posições e grupos) -->
		<section id="arrange-step" class="cc-card rounded-3xl p-6 md:p-10 space-y-6 cc-animate-in hidden">
			<div class="flex items-start justify-between gap-4 flex-wrap">
				<div>
					<h2 class="text-xl md:text-2xl font-bold text-slate-900">Organizar times</h2>
					<p id="arrange-sub" class="text-slate-500 text-sm mt-1"></p>
				</div>
				<button type="button" id="btn-back" class="cc-btn cc-btn-ghost">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
					Voltar
				</button>
			</div>

			<!-- Quantidade de grupos (apenas no formato Fase de Grupos) -->
			<div id="group-count-row" class="hidden items-center gap-2">
				<label class="text-xs text-slate-600 font-medium">Quantidade de grupos:</label>
				<div class="flex items-center rounded-xl bg-blue-50 border border-blue-200">
					<button type="button" id="btn-grp-minus" class="px-3 py-1.5 text-blue-700 font-bold hover:bg-blue-100 rounded-l-xl">−</button>
					<input id="group-count" type="number" min="1" value="2"
						class="w-14 text-center bg-transparent border-0 font-semibold text-blue-800 focus:outline-none" />
					<button type="button" id="btn-grp-plus" class="px-3 py-1.5 text-blue-700 font-bold hover:bg-blue-100 rounded-r-xl">+</button>
				</div>
			</div>

			<div id="arrange-body"></div>
			<p id="arrange-error" class="text-sm text-rose-600 hidden"></p>

			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3 pt-2">
				<button type="button" id="btn-generate" class="cc-btn cc-btn-primary text-base">
					Gerar Tabela
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M13 5l7 7-7 7"/>
					</svg>
				</button>
			</div>
		</section>
	</main>
</MainLayout>

<script>
	import { requireSession } from '../lib/auth';

	requireSession();
</script>

<script>
	import { generateTournament, chooseGroupCount } from '../lib/tournament';
	import type { Arrangement } from '../lib/tournament';
	import { saveTournament, saveTournamentRemote } from '../lib/storage';
	import type { Config, Format, Gender, Sport } from '../lib/types';

	// Times-exemplo conforme o esporte — só para acelerar testes.
	const EXAMPLE_TEAMS: Record<Sport, string[]> = {
		futebol:  ['Real Crista', 'Vila Nova', 'Atlético FC', 'União SC', 'Esporte Clube', 'Boavista', 'Grêmio Norte', 'Santa Cruz'],
		basquete: ['Lakers BR', 'Eagles', 'Titans', 'Warriors SP', 'Raptors RJ', 'Hawks', 'Pacers', 'Nets RS'],
		volei:    ['Praia Azul', 'Costa Sol', 'Vulcão', 'Litoral', 'Orquídea', 'Maresia', 'Tornado', 'Estrela'],
	};

	const HINTS: Record<Format, string> = {
		grupos:      'Os times são distribuídos em grupos, os 2 primeiros de cada grupo avançam para o mata-mata.',
		corrido:     'Todos jogam contra todos; o campeão é quem somar mais pontos ao final.',
		'mata-mata': 'Eliminação direta — em caso de número ímpar, as melhores posições começam com BYE.',
	};

	const grid         = document.getElementById('teams-grid') as HTMLDivElement;
	const countInput   = document.getElementById('team-count') as HTMLInputElement;
	const btnPlus      = document.getElementById('btn-plus') as HTMLButtonElement;
	const btnMinus     = document.getElementById('btn-minus') as HTMLButtonElement;
	const btnFill      = document.getElementById('btn-fill') as HTMLButtonElement;
	const errEl        = document.getElementById('teams-error') as HTMLParagraphElement;
	const hintEl       = document.getElementById('format-hint') as HTMLParagraphElement;
	const form         = document.getElementById('config-form') as HTMLFormElement;

	function renderTeamInputs(): void {
		const n = Math.max(3, Math.min(32, Number(countInput.value) || 3));
		countInput.value = String(n);

		const current: string[] = Array.from(grid.querySelectorAll<HTMLInputElement>('input[name="team"]')).map(i => i.value);

		grid.innerHTML = '';
		for (let i = 0; i < n; i++) {
			const wrap = document.createElement('div');
			wrap.className = 'flex items-center gap-2';
			wrap.innerHTML = `
				<div class="shrink-0 w-8 h-8 rounded-lg bg-blue-100 text-blue-700 grid place-items-center text-xs font-bold">
					${i + 1}
				</div>
				<input name="team" type="text" autocomplete="off" class="cc-input"
					placeholder="Time ${i + 1}" value="${current[i] ?? ''}" maxlength="32" />
			`;
			grid.appendChild(wrap);
		}
	}

	function getSelected(name: string): string {
		const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
		return el?.value ?? '';
	}

	function updateHint(): void {
		hintEl.textContent = HINTS[getSelected('format') as Format];
	}

	btnPlus.addEventListener('click', () => {
		countInput.value = String(Number(countInput.value) + 1);
		renderTeamInputs();
	});
	btnMinus.addEventListener('click', () => {
		countInput.value = String(Number(countInput.value) - 1);
		renderTeamInputs();
	});
	countInput.addEventListener('input', renderTeamInputs);

	btnFill.addEventListener('click', () => {
		const sport = getSelected('sport') as Sport;
		const pool = EXAMPLE_TEAMS[sport];
		const inputs = Array.from(grid.querySelectorAll<HTMLInputElement>('input[name="team"]'));
		inputs.forEach((inp, idx) => { inp.value = pool[idx % pool.length]; });
	});

	document.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach(el => {
		el.addEventListener('change', updateHint);
	});

	// ---------- Elementos da etapa 2 ----------

	const arrangeStep   = document.getElementById('arrange-step')   as HTMLElement;
	const arrangeBody   = document.getElementById('arrange-body')   as HTMLElement;
	const arrangeSub    = document.getElementById('arrange-sub')    as HTMLElement;
	const arrangeError  = document.getElementById('arrange-error')  as HTMLParagraphElement;
	const groupCountRow = document.getElementById('group-count-row') as HTMLElement;
	const groupCountInp = document.getElementById('group-count')    as HTMLInputElement;
	const btnGrpPlus    = document.getElementById('btn-grp-plus')   as HTMLButtonElement;
	const btnGrpMinus   = document.getElementById('btn-grp-minus')  as HTMLButtonElement;
	const btnBack       = document.getElementById('btn-back')       as HTMLButtonElement;
	const btnGenerate   = document.getElementById('btn-generate')   as HTMLButtonElement;

	// Estado capturado na etapa 1 e manipulado na etapa 2.
	let config: Config | null = null;
	let groups: string[][] = [];   // formato 'grupos'
	let order:  string[]   = [];   // formato 'corrido' / 'mata-mata'
	let dragSrc: { g: number; t: number } | null = null;   // arrasto em andamento

	function escapeHtml(s: string): string {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	// ---------- Etapa 1 → valida e avança para a organização ----------

	form.addEventListener('submit', (ev) => {
		ev.preventDefault();
		errEl.classList.add('hidden');

		const inputs = Array.from(grid.querySelectorAll<HTMLInputElement>('input[name="team"]'));
		const teams  = inputs.map(i => i.value.trim()).filter(Boolean);

		if (teams.length < 3) {
			errEl.textContent = 'Preencha ao menos 3 times para criar o campeonato.';
			errEl.classList.remove('hidden');
			return;
		}

		const dup = teams.find((t, i) => teams.indexOf(t) !== i);
		if (dup) {
			errEl.textContent = `Nome de time duplicado: "${dup}". Os nomes precisam ser únicos.`;
			errEl.classList.remove('hidden');
			return;
		}

		config = {
			teams,
			sport:  getSelected('sport')  as Sport,
			gender: getSelected('gender') as Gender,
			format: getSelected('format') as Format,
		};

		enterArrangeStep();
	});

	// ---------- Etapa 2: organização manual ----------

	function enterArrangeStep(): void {
		if (!config) return;
		arrangeError.classList.add('hidden');

		if (config.format === 'grupos') {
			const maxGroups  = Math.max(1, Math.floor(config.teams.length / 2));
			const suggested  = Math.max(1, Math.min(maxGroups, chooseGroupCount(config.teams.length)));
			groupCountInp.max = String(maxGroups);
			groupCountInp.value = String(suggested);
			groups = [];                 // força redistribuição a partir dos times da etapa 1
			distributeGroups(suggested);
			groupCountRow.classList.remove('hidden');
			groupCountRow.classList.add('flex');
			arrangeSub.textContent = 'Escolha a quantidade de grupos e posicione cada time. Os 2 primeiros de cada grupo avançam.';
		} else {
			order = [...config.teams];
			groupCountRow.classList.add('hidden');
			groupCountRow.classList.remove('flex');
			arrangeSub.textContent = config.format === 'mata-mata'
				? 'Defina a posição dos times no chaveamento — o preview mostra os confrontos da 1ª rodada.'
				: 'Defina a ordem dos times — vale como ordem inicial da tabela e do calendário.';
		}

		form.classList.add('hidden');
		arrangeStep.classList.remove('hidden');
		renderArrange();
		window.scrollTo({ top: 0, behavior: 'smooth' });
	}

	btnBack.addEventListener('click', () => {
		arrangeStep.classList.add('hidden');
		form.classList.remove('hidden');
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	// --- Grupos ---

	/** Reparte todos os times atuais em `count` grupos (sequencial: time i → grupo i % count). */
	function distributeGroups(count: number): void {
		const all = groups.length ? groups.flat() : [...(config?.teams ?? [])];
		const buckets: string[][] = Array.from({ length: count }, () => []);
		all.forEach((t, i) => buckets[i % count].push(t));
		groups = buckets;
	}

	function setGroupCount(count: number): void {
		if (!config) return;
		const max = Math.max(1, Math.floor(config.teams.length / 2));
		const c = Math.max(1, Math.min(max, Number.isFinite(count) ? count : 1));
		groupCountInp.value = String(c);
		distributeGroups(c);
		renderArrange();
	}

	btnGrpPlus.addEventListener('click',  () => setGroupCount(Number(groupCountInp.value) + 1));
	btnGrpMinus.addEventListener('click', () => setGroupCount(Number(groupCountInp.value) - 1));
	groupCountInp.addEventListener('change', () => setGroupCount(Number(groupCountInp.value)));

	function renderArrange(): void {
		if (!config) return;
		arrangeError.classList.add('hidden');
		if (config.format === 'grupos') renderGroups();
		else renderOrder();
	}

	function renderGroups(): void {
		const letter = (i: number) => String.fromCharCode(65 + i);
		arrangeBody.innerHTML = `
			<p class="text-xs text-slate-500 mb-3">Arraste os times para o grupo que quiser — ou use o seletor de grupo / as setas para reordenar.</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				${groups.map((g, gi) => `
					<div class="cc-group-drop rounded-2xl border border-blue-100 bg-blue-50/40 overflow-hidden transition" data-group-drop="${gi}">
						<div class="px-4 py-2.5 bg-blue-100/70 font-bold text-slate-800 text-sm uppercase tracking-wide">
							Grupo ${letter(gi)} <span class="text-slate-500 font-medium normal-case">· ${g.length} time(s)</span>
						</div>
						<ul class="divide-y divide-blue-50 min-h-[3rem]">
							${g.length === 0
								? '<li class="px-4 py-3 text-sm text-slate-400 italic">Solte um time aqui</li>'
								: g.map((team, ti) => `
								<li class="px-3 py-2 flex items-center gap-1.5 bg-white cursor-move" draggable="true" data-team-row data-g="${gi}" data-t="${ti}">
									<span class="shrink-0 text-slate-300 select-none" aria-hidden="true">⋮⋮</span>
									<span class="shrink-0 w-6 h-6 rounded-md bg-white text-blue-700 grid place-items-center text-xs font-bold border border-blue-100">${ti + 1}</span>
									<span class="flex-1 min-w-0 truncate text-slate-800 text-sm" title="${escapeHtml(team)}">${escapeHtml(team)}</span>
									<button type="button" class="p-1 rounded text-slate-400 hover:text-blue-700 ${ti === 0 ? 'invisible' : ''}" data-move="up" data-g="${gi}" data-t="${ti}" aria-label="Subir">▲</button>
									<button type="button" class="p-1 rounded text-slate-400 hover:text-blue-700 ${ti === g.length - 1 ? 'invisible' : ''}" data-move="down" data-g="${gi}" data-t="${ti}" aria-label="Descer">▼</button>
									<select class="cc-grp-sel text-xs rounded-lg border border-blue-200 bg-white px-1.5 py-1 text-slate-700" data-g="${gi}" data-t="${ti}" aria-label="Mover para grupo">
										${groups.map((_, gj) => `<option value="${gj}" ${gj === gi ? 'selected' : ''}>${letter(gj)}</option>`).join('')}
									</select>
								</li>
							`).join('')}
						</ul>
					</div>
				`).join('')}
			</div>
		`;
		attachGroupListeners();
	}

	/** Move um time de (sg,st) para o grupo dg, inserindo na posição di. */
	function moveTeam(sg: number, st: number, dg: number, di: number): void {
		const [team] = groups[sg].splice(st, 1);
		if (sg === dg && st < di) di--;          // remoção deslocou o índice de destino
		di = Math.max(0, Math.min(di, groups[dg].length));
		groups[dg].splice(di, 0, team);
		renderGroups();
	}

	function attachGroupListeners(): void {
		// Setas: reordenam dentro do grupo.
		arrangeBody.querySelectorAll<HTMLButtonElement>('button[data-move]').forEach(btn => {
			btn.addEventListener('click', () => {
				const gi = Number(btn.dataset.g), ti = Number(btn.dataset.t);
				const j  = btn.dataset.move === 'up' ? ti - 1 : ti + 1;
				const g  = groups[gi];
				if (j < 0 || j >= g.length) return;
				[g[ti], g[j]] = [g[j], g[ti]];
				renderGroups();
			});
		});

		// Seletor A/B/C…: move o time para outro grupo (alternativa ao arrasto, p/ touch).
		arrangeBody.querySelectorAll<HTMLSelectElement>('select.cc-grp-sel').forEach(sel => {
			sel.addEventListener('change', () => {
				const gi = Number(sel.dataset.g), ti = Number(sel.dataset.t);
				const target = Number(sel.value);
				if (target === gi) return;
				moveTeam(gi, ti, target, groups[target].length);
			});
		});

		// Arrastar e soltar.
		arrangeBody.querySelectorAll<HTMLElement>('li[data-team-row]').forEach(li => {
			li.addEventListener('dragstart', (e) => {
				dragSrc = { g: Number(li.dataset.g), t: Number(li.dataset.t) };
				if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
				li.classList.add('opacity-40');
			});
			li.addEventListener('dragend', () => {
				li.classList.remove('opacity-40');
				dragSrc = null;
			});
			// Soltar sobre um time → insere naquela posição.
			li.addEventListener('dragover', (e) => e.preventDefault());
			li.addEventListener('drop', (e) => {
				e.preventDefault();
				e.stopPropagation();
				if (!dragSrc) return;
				moveTeam(dragSrc.g, dragSrc.t, Number(li.dataset.g), Number(li.dataset.t));
			});
		});

		// Soltar em qualquer lugar do card do grupo → vai para o fim do grupo.
		arrangeBody.querySelectorAll<HTMLElement>('[data-group-drop]').forEach(zone => {
			zone.addEventListener('dragover', (e) => {
				e.preventDefault();
				zone.classList.add('ring-2', 'ring-blue-400', 'ring-inset');
			});
			zone.addEventListener('dragleave', () => {
				zone.classList.remove('ring-2', 'ring-blue-400', 'ring-inset');
			});
			zone.addEventListener('drop', (e) => {
				e.preventDefault();
				zone.classList.remove('ring-2', 'ring-blue-400', 'ring-inset');
				if (!dragSrc) return;
				const dg = Number(zone.dataset.groupDrop);
				moveTeam(dragSrc.g, dragSrc.t, dg, groups[dg].length);
			});
		});
	}

	function renderOrder(): void {
		const isKo = config!.format === 'mata-mata';
		arrangeBody.innerHTML = `
			<div class="grid grid-cols-1 ${isKo ? 'lg:grid-cols-2' : ''} gap-5">
				<div>
					<h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Ordem dos times</h3>
					<ul class="rounded-2xl border border-blue-100 divide-y divide-blue-50 overflow-hidden">
						${order.map((team, i) => `
							<li class="px-3 py-2.5 flex items-center gap-1.5 bg-white">
								<span class="shrink-0 w-7 h-7 rounded-lg bg-blue-100 text-blue-700 grid place-items-center text-xs font-bold">${i + 1}</span>
								<span class="flex-1 min-w-0 truncate text-slate-800 text-sm" title="${escapeHtml(team)}">${escapeHtml(team)}</span>
								<button type="button" class="p-1 rounded text-slate-400 hover:text-blue-700 ${i === 0 ? 'invisible' : ''}" data-move="up" data-i="${i}" aria-label="Subir">▲</button>
								<button type="button" class="p-1 rounded text-slate-400 hover:text-blue-700 ${i === order.length - 1 ? 'invisible' : ''}" data-move="down" data-i="${i}" aria-label="Descer">▼</button>
							</li>
						`).join('')}
					</ul>
				</div>
				${isKo ? `<div><h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Confrontos da 1ª rodada</h3>${knockoutPreview(order)}</div>` : ''}
			</div>
		`;

		arrangeBody.querySelectorAll<HTMLButtonElement>('button[data-move]').forEach(btn => {
			btn.addEventListener('click', () => {
				const i = Number(btn.dataset.i);
				const j = btn.dataset.move === 'up' ? i - 1 : i + 1;
				if (j < 0 || j >= order.length) return;
				[order[i], order[j]] = [order[j], order[i]];
				renderOrder();
			});
		});
	}

	/** Preview dos confrontos da 1ª rodada do mata-mata, conforme a ordem (seeds). */
	function knockoutPreview(seeds: string[]): string {
		const n = seeds.length;
		let p = 1; while (p < n) p <<= 1;
		const byes = p - n;
		const advancing = seeds.slice(0, byes);
		const rest = seeds.slice(byes);
		const pairs: Array<[string, string]> = [];
		for (let i = 0; i < rest.length; i += 2) pairs.push([rest[i], rest[i + 1]]);

		return `
			${byes > 0 ? `<p class="text-[11px] text-amber-700 mb-2">${advancing.map(escapeHtml).join(', ')} avança(m) direto (BYE).</p>` : ''}
			<ul class="space-y-2">
				${pairs.map(([a, b]) => `
					<li class="rounded-xl border border-blue-50 bg-white px-3 py-2.5 flex items-center gap-2 text-sm">
						<span class="flex-1 text-right truncate text-slate-800" title="${escapeHtml(a)}">${escapeHtml(a)}</span>
						<span class="text-slate-400 text-xs font-semibold px-2">x</span>
						<span class="flex-1 truncate text-slate-800" title="${escapeHtml(b)}">${escapeHtml(b)}</span>
					</li>
				`).join('')}
			</ul>
		`;
	}

	// --- Geração final ---

	btnGenerate.addEventListener('click', async () => {
		if (!config) return;
		arrangeError.classList.add('hidden');

		let arrangement: Arrangement;
		if (config.format === 'grupos') {
			if (groups.some(g => g.length < 2)) {
				arrangeError.textContent = 'Cada grupo precisa de pelo menos 2 times. Ajuste a distribuição.';
				arrangeError.classList.remove('hidden');
				return;
			}
			arrangement = { groups: groups.map(g => [...g]) };
		} else {
			arrangement = { order: [...order] };
		}

		const t = generateTournament(config, arrangement);
		saveTournament(t);

		// Aguarda o banco confirmar antes de sair, para que o painel já carregue o
		// torneio recém-criado a partir do Supabase (e não só do cache local).
		btnGenerate.disabled = true;
		const ok = await saveTournamentRemote(t);
		if (!ok) {
			arrangeError.textContent = 'Não foi possível salvar no banco de dados. Verifique a conexão e tente novamente.';
			arrangeError.classList.remove('hidden');
			btnGenerate.disabled = false;
			return;
		}

		// Volta para a listagem — o torneio recém-criado aparece no topo.
		window.location.href = '/painel';
	});

	renderTeamInputs();
	updateHint();
</script>
